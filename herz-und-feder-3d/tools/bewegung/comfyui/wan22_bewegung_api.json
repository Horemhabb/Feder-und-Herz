{
  "_hinweis": "ComfyUI-Workflow im API-Format: Wan 2.2 TI2V 5B erzeugt ein kurzes Video einer Figur, die eine Bewegung ausführt. Nachgebaut aus der offiziellen ComfyUI-Vorlage 'Wan 2.2 5B Video Generation', NICHT auf dem PC geprüft. bewegungswerk.bat ersetzt TEXT, BREITE, HOEHE, BILDER und SAAT. Kleine Größe (832 x 480, 49 Bilder = 2 s) wegen 16 GB und AMD; Entschlüsseln in Kacheln wie im Bildwerk.",
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
  "4": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": 8.0}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "TEXT"}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["2", 0], "text": "camera movement, zoom, cut, several people, cropped body, blurry limbs, extra limbs, text, watermark, dark background"}},
  "7": {"class_type": "Wan22ImageToVideoLatent", "inputs": {"vae": ["3", 0], "width": 832, "height": 480, "length": 49, "batch_size": 1}},
  "8": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0], "seed": 1, "steps": 20, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0}},
  "9": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["8", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 32, "temporal_overlap": 8}},
  "10": {"class_type": "CreateVideo", "inputs": {"images": ["9", 0], "fps": 24.0}},
  "11": {"class_type": "SaveVideo", "inputs": {"video": ["10", 0], "filename_prefix": "bewegung/wan", "format": "mp4", "codec": "h264"}}
}
